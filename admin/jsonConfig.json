{
  "i18n": true,
  "type": "tabs",
  "items": {
    "_settings": {
      "type": "panel",
      "label": "Settings",
      "items": {
        "bindAddress": {
          "type": "ip",
          "label": "Local address",
          "default": "0.0.0.0",
          "sm": 12,
          "md": 6,
          "lg": 4
        },
        "schedule": {
          "newLine": true,
          "type": "cron",
          "label": "Schedule of the automatic test",
          "help": "Leave empty to start the test only on demand with the state test.start",
          "simple": true,
          "sm": 12,
          "md": 6,
          "lg": 4
        }
      }
    },
    "_test": {
      "type": "panel",
      "label": "Speed test",
      "items": {
        "_speedtest": {
          "type": "custom",
          "webComponent": "webcomponents/vofo-speedtest.json",
          "settings": {
            "instance": "vofo-speedtest.${_instance}",
            "layout": "full"
          },
          "height": 320,
          "sm": 12,
          "md": 8,
          "lg": 6
        }
      }
    }
  }
}
