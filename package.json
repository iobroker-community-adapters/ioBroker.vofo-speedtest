{
  "name": "iobroker.vofo-speedtest",
  "version": "3.0.1",
  "description": "Speedtest of Vodafone.de",
  "author": "Peter Baumert <ioBroker.vodafone-speedtest@outlook.com>",
  "contributors": [
    "mcm1957 <mcm57@gmx.at>",
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.vofo-speedtest",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "speedtest",
    "speed",
    "bandwidth"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iobroker-community-adapters/ioBroker.vofo-speedtest"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "ping": "^1.0.0",
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/types": "^7.2.5",
    "@iobroker/web-components": "^0.8.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@types/node-schedule": "^2.1.8",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "build/",
    "admin/",
    "widgets/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:widgets && npm run build:devices && npm run build:wc && iob-web-components sync-io-package",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:widgets": "node tasks.mts",
    "build:devices": "node tasks.mts --devices",
    "build:wc": "node tasks.mts --wc",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tasks.json --noEmit && tsc -p src-shared/tsconfig.json",
    "lint": "node tasks.mts --install && eslint -c eslint.config.mjs src src-shared tasks.mts && cd src-widgets && npm run lint && cd ../src-devices && npm run lint && cd ../src-webcomponents && npm run lint",
    "test:package": "mocha test/packageFiles --exit",
    "test:integration": "mocha test/integrationAdapter --exit",
    "test": "npm run test:package",
    "translate": "translate-adapter -b admin/i18n/en.json",
    "npm": "npm i && cd src-widgets && npm i && cd ../src-devices && npm i && cd ../src-webcomponents && npm i",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx npm-check-updates --upgrade"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.vofo-speedtest/issues"
  },
  "readmeFilename": "README.md"
}
